import polars as pl

def normalize(col: pl.Expr) -> pl.Expr:
    s = col.cast(pl.Utf8).str.strip()

    return (
        pl.when(s.is_null() | (s == ""))
        .then(None)

        # ---------- NUMERIC NORMALIZATION ----------
        .when(
            s.str.contains(r"^[+-]?\d+(\.\d+)?$")
        )
        .then(
            s.cast(pl.Float64)
             .round(6)               # numeric tolerance
             .cast(pl.Utf8)
        )

        # ---------- DATE NORMALIZATION ----------
        .when(
            s.str.contains(r"^\d{1,2}[/-]\d{1,2}[/-]\d{2,4}$") |
            s.str.contains(r"^\d{4}-\d{2}-\d{2}")
        )
        .then(
            pl.coalesce(
                s.str.strptime(pl.Date, "%Y-%m-%d", strict=False),
                s.str.strptime(pl.Date, "%d-%m-%Y", strict=False),
                s.str.strptime(pl.Date, "%d/%m/%Y", strict=False),
                s.str.strptime(pl.Date, "%m/%d/%Y", strict=False),
            ).cast(pl.Utf8)
        )

        # ---------- STRING FALLBACK ----------
        .otherwise(s)
    )



# -------------------------------------------------
# Main reconciliation function
# -------------------------------------------------
def reconcile_files(
    file1: str,
    file2: str,
    pk_cols: List[str]
) -> pd.DataFrame:

    df1 = read_file(file1)
    df2 = read_file(file2)

    # Identify data columns
    data_cols = [c for c in df1.columns if c not in pk_cols]

    # Join on primary keys
    joined = df1.join(
        df2,
        on=pk_cols,
        how="inner",
        suffix="_after"
    )

    # Build mismatch details (NO helper columns)
    diffs_expr = pl.concat_list([
        pl.when(
            ~normalize(pl.col(c)).eq_missing(
                normalize(pl.col(f"{c}_after"))
            )
        )
        .then(
            pl.struct(
                pl.lit(c).alias("column"),
                pl.col(c).alias("before"),
                pl.col(f"{c}_after").alias("after"),
            )
        )
        .otherwise(None)
        for c in data_cols
    ]).list.drop_nulls()

    # Final audit table
    audit = (
        joined
        .with_columns(
            diffs=diffs_expr,
            mismatch_columns=diffs_expr.list.eval(
                pl.element().struct.field("column")
            )
        )
        .filter(pl.col("diffs").list.len().fill_null(0) > 0)
        .select(
            *pk_cols,
            pl.col("mismatch_columns").alias("Mismatch_Columns"),
            pl.col("diffs").alias("Mismatch_Details"),
        )
    )

    # Return pandas DataFrame
    return audit.collect().to_pandas()
